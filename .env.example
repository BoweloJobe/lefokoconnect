# Copy this file to .env before running the server locally.

# Required for Gemini AI puzzle generation and cultural hints.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional. Verify the latest supported model name in the Gemini console.
GEMINI_MODEL="gemini-3.5-flash"

# Required for protected admin-only puzzle generation.
# Use a long random value and send it as: Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN="change-me-to-a-long-random-token"

# Public URL where the app is hosted.
APP_URL="http://localhost:3000"

# Optional. Many production hosts inject PORT automatically.
PORT=3000
